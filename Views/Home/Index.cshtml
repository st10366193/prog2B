@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Login";
}

<h2 class="text-center">Login</h2>

<div class="mb-3">
    <label>Username</label>
    <input class="form-control" placeholder="Enter username" />
</div>
<div class="mb-3">
    <label>Password</label>
    <input type="password" class="form-control" placeholder="Enter password" />
</div>


<a href="/Home/LecturerDashboard" class="btn btn-primary w-100">Login as Lecturer</a>
<a href="/Home/CoordinatorDashboard" class="btn btn-secondary w-100 mt-2">Login as Coordinator</a>


